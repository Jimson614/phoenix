# Local Demo only. No credentials; backend/server.js reads PFS_* only.
# Node does not load this file automatically.
# Example from the Family OS root: node --env-file=.env.example backend/server.js
PFS_BACKEND_HOST=127.0.0.1
PFS_BACKEND_PORT=8787
PFS_ENABLE_DEMO_AUTH=true
# PFS_DATABASE_PATH is intentionally omitted: backend defaults to backend/data/phoenix-family-os.sqlite.
# Do not set production paths, DATABASE_URL, JWT_SECRET or AI_API_KEY here: they are not used by this runtime.
