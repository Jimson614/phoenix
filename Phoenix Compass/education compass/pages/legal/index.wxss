.legal {
  padding: 0 0 40rpx;
  background: var(--pn-bg, #faf7f1);
  min-height: 100vh;
}

.legal__hero {
  padding: 40rpx 40rpx 32rpx;
  background: linear-gradient(160deg, #fffdf9, #fbf3e7);
  border-bottom: 1rpx solid var(--pn-line, #eadfce);
}

.legal__kicker {
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: var(--pn-gold-deep, #966313);
}

.legal__title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: var(--pn-ink, #102238);
  margin-top: 12rpx;
}

.legal__notes {
  margin-top: 16rpx;
}

.legal__note {
  display: block;
  font-size: 22rpx;
  color: var(--pn-muted, #85817a);
  line-height: 1.6;
}

.legal__body {
  padding: 8rpx 40rpx 0;
}

.legal__h2 {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--pn-ink, #102238);
  margin: 36rpx 0 16rpx;
  padding-left: 18rpx;
  border-left: 6rpx solid var(--pn-gold, #b98426);
}

.legal__h3 {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--pn-ink-secondary, #465563);
  margin: 24rpx 0 12rpx;
}

.legal__p {
  font-size: 28rpx;
  line-height: 1.8;
  color: var(--pn-ink-secondary, #465563);
  margin: 12rpx 0;
}

.legal__b {
  font-weight: 700;
  color: var(--pn-ink, #102238);
}

.legal__var {
  color: var(--pn-gold-deep, #966313);
  background: var(--pn-gold-wash, #fbedd2);
  padding: 0 6rpx;
  border-radius: 6rpx;
}

.legal__ol,
.legal__ul {
  margin: 12rpx 0;
}

.legal__li {
  display: flex;
  font-size: 28rpx;
  line-height: 1.8;
  color: var(--pn-ink-secondary, #465563);
  margin: 8rpx 0;
}

.legal__li-num {
  width: 44rpx;
  flex: none;
  color: var(--pn-gold-deep, #966313);
  font-weight: 700;
}

.legal__dot {
  width: 28rpx;
  flex: none;
  color: var(--pn-gold, #b98426);
}

.legal__li-txt {
  flex: 1;
}

.legal__note-block {
  font-size: 24rpx;
  color: var(--pn-muted, #85817a);
  background: var(--pn-surface-warm, #fbf3e7);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin: 16rpx 0;
}

.legal__confirm {
  display: flex;
  align-items: center;
  margin: 20rpx 0;
  padding: 20rpx 24rpx;
  background: var(--pn-gold-wash, #fbedd2);
  border: 1rpx dashed var(--pn-gold, #b98426);
  border-radius: 12rpx;
}

.legal__confirm-tag {
  font-size: 20rpx;
  color: #fff;
  background: var(--pn-gold-deep, #966313);
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  margin-right: 16rpx;
  flex: none;
}

.legal__confirm-txt {
  font-size: 26rpx;
  color: var(--pn-ink, #102238);
  font-weight: 600;
}

.legal__divider {
  height: 1rpx;
  background: var(--pn-line, #eadfce);
  margin: 28rpx 0;
}

.legal__footer {
  padding: 32rpx 40rpx 60rpx;
  border-top: 1rpx solid var(--pn-line, #eadfce);
  margin-top: 20rpx;
}

.legal__footer text {
  display: block;
  font-size: 22rpx;
  color: var(--pn-muted-light, #aaa49b);
  line-height: 1.7;
}
