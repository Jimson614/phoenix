.masters-materials { min-height: 100vh; }
.masters-materials__page { padding-bottom: calc(96rpx + env(safe-area-inset-bottom)); }
.masters-materials__topbar { align-items: center; display: flex; justify-content: space-between; }
.masters-materials__topbar .btn { font-size: 24rpx; margin-left: -14rpx; }
.masters-materials__heading { margin: 48rpx 0 28rpx; }
.masters-materials__heading .h1 { display: block; margin-top: 14rpx; }
.masters-materials__heading .muted { margin-top: 14rpx; }
.masters-consent { margin-top: 24rpx; }
.masters-consent__head { align-items: center; display: flex; justify-content: space-between; }
.masters-consent .muted { margin-top: 14rpx; }
.resume-start { margin-top: 22rpx; }
.resume-start > .muted { display: block; line-height: 1.55; margin-top: 12rpx; }
.resume-priority-actions { display: flex; gap: 14rpx; margin-top: 20rpx; }
.resume-priority-actions .btn { flex: 1; font-size: 23rpx; padding-left: 10rpx; padding-right: 10rpx; }
.resume-review-card, .resume-empty { border-top: 1rpx solid var(--line); margin-top: 22rpx; padding-top: 20rpx; }
.resume-review-card > .btn, .resume-start > .btn { font-size: 22rpx; margin-top: 14rpx; width: 100%; }
.resume-facts, .resume-missing, .resume-conflicts, .resume-manual-review { margin-top: 18rpx; }
.resume-review__label { color: var(--gold-deep); display: block; font-size: 21rpx; font-weight: 650; margin-bottom: 8rpx; }
.resume-fact { align-items: flex-start; border-top: 1rpx solid var(--line); display: flex; gap: 16rpx; justify-content: space-between; padding: 10rpx 0; }
.resume-fact__edit { background: transparent; border: 0; border-radius: 0; color: var(--navy); font-size: 22rpx; line-height: 1.5; margin: 0; padding: 0; text-align: left; width: 100%; }
.resume-fact__edit::after { border: 0; }
.resume-missing__tags { display: flex; flex-wrap: wrap; gap: 8rpx; }
.resume-fact-editor, .resume-missing-editor { background: rgba(255,253,249,.72); border: 1rpx solid var(--line); border-radius: var(--radius-sm); margin-top: 14rpx; padding: 18rpx; }
.resume-fact-editor .picker { margin-top: 12rpx; }
.resume-missing-editor .field { margin-top: 18rpx; }
.resume-missing-editor .check-line { margin-top: 16rpx; }
.resume-review__ready { color: var(--success); display: block; font-size: 22rpx; line-height: 1.5; margin-top: 18rpx; }
.resume-conflict { color: var(--danger); display: block; font-size: 21rpx; line-height: 1.5; margin-top: 8rpx; }
.resume-manual-review .muted { display: block; font-size: 21rpx; line-height: 1.5; margin-top: 8rpx; }
.resume-required-section { margin-top: 24rpx; }
.guided-progress { margin-top: 24rpx; }
.guided-step-tabs { display: flex; gap: 8rpx; margin-top: 18rpx; overflow-x: auto; }
.guided-step-tabs .btn { flex-shrink: 0; font-size: 21rpx; height: 64rpx; padding: 0 14rpx; }
.guided-progress > .muted { display: block; line-height: 1.5; margin-top: 14rpx; }
.guided-navigation { display: flex; gap: 14rpx; margin-top: 24rpx; }
.guided-navigation .btn { flex: 1; }
.check-line { align-items: center; display: flex; gap: 10rpx; line-height: 1.55; margin-top: 20rpx; }
.check-line checkbox { transform: scale(.86); }
.field-gap { margin-top: 16rpx; }
.field-grid { display: flex; gap: 18rpx; }
.field-grid > view { flex: 1; min-width: 0; }
.field-grid .field { margin-top: 30rpx; }
.radio-row { display: flex; gap: 28rpx; }
.radio-row label { align-items: center; display: flex; font-size: 25rpx; }
.radio-row radio { transform: scale(.86); }
.subscore-grid { display: grid; gap: 12rpx; grid-template-columns: repeat(4, minmax(0, 1fr)); margin-top: 18rpx; }
.subscore-grid text { color: var(--muted); display: block; font-size: 21rpx; margin: 0 0 8rpx 4rpx; }
.subscore-grid .input { font-size: 23rpx; padding-left: 14rpx; padding-right: 14rpx; }
.experience-row { border-top: 1rpx solid var(--line); margin-top: 28rpx; padding-top: 22rpx; }
.experience-remove { color: var(--danger); font-size: 22rpx; height: 58rpx; }
.experience-row .picker { display: block; margin-top: 14rpx; }
.add-experience { font-size: 24rpx; height: 82rpx; margin-top: 24rpx; width: 100%; }
.materials-section { margin-bottom: 16rpx; }
.document-note { margin-bottom: 16rpx; padding: 22rpx 26rpx; }
.document-card { margin-top: 18rpx; padding: 28rpx; }
.document-card__head { align-items: flex-start; display: flex; gap: 14rpx; }
.document-card__head .h3 { display: block; }
.document-card__head .muted { margin-top: 8rpx; }
.document-card__head .status { flex-shrink: 0; }
.document-card__upload { font-size: 24rpx; height: 84rpx; margin-top: 22rpx; width: 100%; }
.document-card__photo { font-size: 21rpx; height: 64rpx; margin-top: 4rpx; width: 100%; }
.document-file { align-items: flex-start; border-top: 1rpx solid var(--line); display: flex; gap: 14rpx; margin-top: 18rpx; padding-top: 18rpx; }
.document-file__name, .document-file__meta, .document-file__error { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.document-file__name { color: var(--navy); font-size: 24rpx; max-width: 440rpx; }
.document-file__meta { color: var(--muted); font-size: 20rpx; margin-top: 5rpx; }
.document-file__error { color: var(--danger); font-size: 20rpx; line-height: 1.45; margin-top: 6rpx; white-space: normal; }
.document-file__manual { color: var(--muted); display: block; font-size: 20rpx; line-height: 1.45; padding: 8rpx; }
.document-file__actions { align-items: center; display: flex; flex-shrink: 0; flex-wrap: wrap; justify-content: flex-end; }
.document-file__actions .btn { font-size: 20rpx; height: 54rpx; padding: 0 8rpx; }
.document-file__remove { color: var(--danger); }
.document-card--supplemental { background: rgba(255,253,249,.72); }
.hidden-documents { margin-top: 18rpx; }
.hidden-documents .muted { margin-top: 9rpx; }
.hidden-document { border-top: 1rpx solid var(--line); display: flex; justify-content: space-between; margin-top: 14rpx; padding-top: 14rpx; }
.hidden-document text:first-child { color: var(--navy); font-size: 22rpx; max-width: 55%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.hidden-document text:last-child { color: var(--muted); font-size: 19rpx; }
.masters-materials__footer { margin-top: 34rpx; }
.masters-materials__footer .btn { width: 100%; }
.upload-warning, .saved-note { display: block; font-size: 21rpx; line-height: 1.55; margin-bottom: 14rpx; text-align: center; }
.upload-warning { color: var(--danger); }
.saved-note { color: var(--success); }
.masters-materials__error { background: #fff1ee; border-radius: var(--radius-md); color: var(--danger); font-size: 22rpx; line-height: 1.55; margin-top: 18rpx; padding: 18rpx 20rpx; }
.extraction-error, .extraction-review { margin-top: 20rpx; }
.extraction-error .muted, .extraction-review .muted { display: block; line-height: 1.55; margin-top: 8rpx; }
.extraction-error .btn { margin-top: 12rpx; }
.extraction-item { border-top: 1rpx solid var(--line); display: flex; gap: 16rpx; justify-content: space-between; margin-top: 17rpx; padding-top: 17rpx; }
.extraction-item__copy { flex: 1; min-width: 0; }
.extraction-item__field, .extraction-item__value, .extraction-item__source, .extraction-item__existing, .extraction-item__decision { display: block; }
.extraction-item__field { color: var(--gold-deep); font-size: 21rpx; font-weight: 650; }
.extraction-item__value { color: var(--navy); font-size: 25rpx; margin-top: 6rpx; word-break: break-all; }
.extraction-item__source, .extraction-item__existing { color: var(--muted); font-size: 19rpx; line-height: 1.5; margin-top: 6rpx; }
.extraction-item__decision { color: var(--success); font-size: 20rpx; margin-top: 7rpx; }
.extraction-item__actions { display: flex; flex-direction: column; flex-shrink: 0; }
.extraction-item__actions .btn { font-size: 21rpx; height: 58rpx; padding: 0 10rpx; }
.extraction-item__reject { color: var(--danger); }

@media (max-width: 360px) {
  .masters-materials__page { padding-left: 28rpx; padding-right: 28rpx; }
  .field-grid { display: block; }
  .field-grid > view + view .field { margin-top: 18rpx; }
  .subscore-grid { gap: 8rpx; }
  .subscore-grid .input { font-size: 20rpx; padding-left: 9rpx; padding-right: 9rpx; }
  .resume-priority-actions { display: block; }
  .resume-priority-actions .btn + .btn { margin-top: 10rpx; }
  .hidden-document { display: block; }
  .hidden-document text { display: block; max-width: 100%; }
  .hidden-document text:last-child { margin-top: 6rpx; }
}
