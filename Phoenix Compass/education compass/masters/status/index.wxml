<view class="masters-status page--screen">
  <view class="page masters-status__page">
    <view class="masters-status__topbar"><button class="btn btn--text" bindtap="back">‹ 返回</button><text class="eyebrow">CONSULTATION STATUS</text></view>
    <view wx:if="{{!enabled}}" class="ui-state"><text class="h3">香港硕士免费咨询暂未开放</text><text class="muted">当前不会读取或提交咨询。</text></view>
    <view wx:elif="{{!loggedIn}}" class="ui-state"><text class="h3">请先登录后继续</text><text class="muted">登录后会回到当前进度页。</text><button class="btn btn--gold" loading="{{loginBusy}}" disabled="{{loginBusy}}" bindtap="login">登录并继续</button></view>
    <block wx:elif="{{loggedIn}}">
      <view wx:if="{{loading}}" class="ui-state" aria-busy="true"><text class="h3">正在读取咨询进度…</text><text class="muted">状态、缺件和报告开放状态以服务端为准。</text></view>
      <block wx:else>
        <view class="masters-status__heading"><text class="eyebrow">APPLICATION COMPASS</text><text class="h1">{{statusLabel}}</text><text class="muted">咨询编号仅用于当前已登录账号的服务端查询。</text></view>
        <view class="panel status-hero"><view class="status-hero__line"><text class="status status--warm">{{statusLabel}}</text><text class="muted">资料版本 {{version}}</text></view><view class="progress-track"><view class="progress-track__fill" style="width: {{status === 'DRAFT' ? '20' : status === 'SUBMITTED' ? '45' : status === 'NEEDS_INFO' ? '50' : status === 'IN_REVIEW' ? '72' : status === 'CLOSED' || status === 'WITHDRAWN' ? '100' : '30'}}%;"></view></view><view class="status-steps"><text class="status-step status-step--done">资料</text><text class="status-step">提交</text><text class="status-step">顾问复核</text><text class="status-step">方案确认</text></view></view>
        <view wx:if="{{missingFields.length || missingDocuments.length || documentRequestNote || documentRequestTypesLabel}}" class="panel missing-panel"><view class="section-head"><text class="h3">待补资料</text><text class="status status--warm">可先提交</text></view><text class="muted">材料不齐不会阻止免费咨询提交；顾问会据实标注限制。</text><view wx:if="{{missingFields.length}}" class="missing-list"><text class="missing-list__label">字段</text><text wx:for="{{missingFields}}" wx:key="*this" class="tag">{{item}}</text></view><view wx:if="{{missingDocuments.length}}" class="missing-list"><text class="missing-list__label">材料</text><text wx:for="{{missingDocuments}}" wx:key="*this" class="tag">{{item}}</text></view><view wx:if="{{documentRequestTypesLabel}}" class="document-request"><text class="missing-list__label">顾问请求材料</text><text>{{documentRequestTypesLabel}}</text></view><text wx:if="{{documentRequestNote}}" class="document-request__note">说明：{{documentRequestNote}}</text></view>
        <view class="panel extraction-panel"><view class="section-head"><text class="h3">材料核验状态</text><text class="status">{{verificationStatus}}</text></view><text class="muted">上传成功、解析成功和咨询提交是三个独立状态。识别失败会保留原件并进入人工核验，不会要求重新填写整份资料。</text><view wx:for="{{documents}}" wx:key="id" class="extraction-row"><text>{{item.name}}</text><text>{{item.uploadStatusLabel}} · {{item.parseStatusLabel}}</text></view></view>
        <view wx:if="{{reportAvailable}}" class="panel report-entry" bindtap="openReport"><text class="eyebrow">RELEASED REPORT</text><text class="h3">查看已开放申请方案</text><text class="muted">只有服务端标记为 RELEASED 的版本可查看和导出。</text><text class="chevron">›</text></view>
        <view class="masters-status__actions"><button wx:if="{{status === 'DRAFT' || status === 'NEEDS_INFO'}}" class="btn btn--outline" bindtap="openMaterials">补充或修改资料</button><button wx:if="{{status === 'DRAFT' || status === 'NEEDS_INFO'}}" class="btn btn--gold" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">提交免费咨询</button><button wx:if="{{status !== 'WITHDRAWN' && status !== 'CLOSED'}}" class="btn btn--text" loading="{{withdrawing}}" disabled="{{withdrawing}}" bindtap="withdraw">撤回咨询</button></view>
        <view wx:if="{{error}}" class="masters-status__error">{{error}}<button class="btn btn--text" bindtap="retry">重新加载</button></view>
      </block>
    </block>
  </view>
</view>
