.masters-workbench { min-height: 100vh; }
.masters-workbench__page { padding-bottom: calc(80rpx + env(safe-area-inset-bottom)); }
.masters-workbench__topbar { align-items: center; display: flex; justify-content: space-between; }
.masters-workbench__topbar .btn { font-size: 24rpx; margin-left: -14rpx; }
.masters-workbench__heading { margin: 50rpx 0 28rpx; }
.masters-workbench__heading .h1 { display: block; margin-top: 12rpx; }
.masters-workbench__heading .muted { display: block; margin-top: 10rpx; }
.masters-workbench__panel { margin-top: 20rpx; }
.masters-workbench__code { margin-bottom: 24rpx; text-align: center; }
.masters-workbench__code-label { color: var(--muted); display: block; font-size: 22rpx; }
.masters-workbench__code-value { color: var(--navy); display: block; font-family: Menlo, Consolas, monospace; font-size: 52rpx; font-weight: 650; letter-spacing: 6rpx; margin: 14rpx 0; }
.masters-workbench__code .muted { display: block; font-size: 22rpx; margin-bottom: 18rpx; }
button.masters-workbench__action { margin-top: 16rpx; width: 100%; }
.masters-workbench__note { display: block; font-size: 21rpx; margin-top: 18rpx; }
.ui-state--short { min-height: 260rpx; }
.masters-workbench__error { background: #fff1ee; border-radius: var(--radius-md); color: var(--danger); font-size: 22rpx; line-height: 1.55; margin-top: 18rpx; padding: 18rpx 20rpx; }
.masters-workbench__error .btn { color: var(--danger); display: block; font-size: 21rpx; margin: 10rpx 0 0; padding-left: 0; }
