.masters-list { min-height: 100vh; }
.masters-list__page { padding-bottom: calc(80rpx + env(safe-area-inset-bottom)); }
.masters-list__topbar { align-items: center; display: flex; justify-content: space-between; }
.masters-list__topbar .btn { font-size: 24rpx; margin-left: -14rpx; }
.masters-list__heading { margin: 50rpx 0 28rpx; }
.masters-list__heading .h1 { display: block; margin-top: 12rpx; }
.masters-list__heading .muted { margin-top: 10rpx; }
.masters-list__items { margin-top: 20rpx; }
.consultation-row { margin-top: 16rpx; position: relative; }
.consultation-row__head { align-items: center; display: flex; gap: 14rpx; justify-content: space-between; padding-right: 34rpx; }
.consultation-row__head .h3 { display: block; }
.consultation-row .muted { margin-top: 10rpx; }
.consultation-row__date { color: var(--muted); display: block; font-size: 20rpx; margin-top: 12rpx; }
.consultation-row .chevron { position: absolute; right: 28rpx; top: 50%; transform: translateY(-50%); }
.masters-list__new { margin-top: 28rpx; width: 100%; }
.ui-state--short { min-height: 260rpx; }
.masters-list__error { background: #fff1ee; border-radius: var(--radius-md); color: var(--danger); font-size: 22rpx; line-height: 1.55; margin-top: 18rpx; padding: 18rpx 20rpx; }
.masters-list__error .btn { color: var(--danger); display: block; font-size: 21rpx; margin: 10rpx 0 0; padding-left: 0; }

@media (max-width: 360px) {
  .masters-list__page { padding-left: 28rpx; padding-right: 28rpx; }
  .consultation-row__head { display: block; }
  .consultation-row__head .status { display: inline-block; margin-top: 10rpx; }
}
