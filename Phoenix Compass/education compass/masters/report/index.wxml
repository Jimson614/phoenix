<view class="masters-report page--screen">
  <view class="page masters-report__page">
    <view class="masters-report__topbar"><button class="btn btn--text" bindtap="back">‹ 返回</button><text class="eyebrow">RELEASED APPLICATION PLAN</text></view>
    <view wx:if="{{!enabled}}" class="ui-state"><text class="h3">香港硕士免费咨询暂未开放</text><text class="muted">当前不会读取方案。</text></view>
    <view wx:elif="{{!loggedIn}}" class="ui-state"><text class="h3">请先登录后继续</text><text class="muted">登录后可查看本人已开放方案。</text><button class="btn btn--gold" loading="{{loginBusy}}" disabled="{{loginBusy}}" bindtap="login">登录并继续</button></view>
    <block wx:elif="{{loggedIn}}">
      <view wx:if="{{loading}}" class="ui-state" aria-busy="true"><text class="h3">正在读取咨询报告…</text><text class="muted">仅展示服务端已批准并开放的版本。</text></view>
      <view wx:elif="{{error}}" class="ui-state"><text class="h3">暂时无法查看方案</text><text class="muted">{{error}}</text><button class="btn btn--outline" bindtap="retry">重新加载</button></view>
      <block wx:else>
        <view class="masters-report__heading"><text class="eyebrow">VERSION {{report.version}}</text><text class="h1">{{report.assistance.label}}</text><text class="muted">已获批准并开放 · 资料版本以审核记录为准</text></view>
        <view class="panel"><text class="body">{{report.assistance.explanation}}</text><text wx:for="{{report.assistance.limitations}}" wx:key="*this" class="report-line">{{item}}</text></view><view class="panel report-summary"><text class="eyebrow">BACKGROUND SUMMARY</text><text class="body">{{payload.backgroundSummary || '暂无摘要'}}</text></view>
        <view class="panel report-strengths"><text class="h2">优势与资料缺口</text><view class="report-columns"><view><text class="report-column__title">优势</text><text wx:for="{{payload.strengthsAndGaps.strengths}}" wx:key="*this" class="report-line">{{item}}</text><text wx:if="{{!payload.strengthsAndGaps.strengths.length}}" class="muted">待顾问补充</text></view><view><text class="report-column__title">缺口</text><text wx:for="{{payload.strengthsAndGaps.gaps}}" wx:key="*this" class="report-line">{{item}}</text><text wx:if="{{!payload.strengthsAndGaps.gaps.length}}" class="muted">暂无</text></view></view></view>
        <view class="panel"><text class="h2">建议申请方向</text><text wx:for="{{payload.suggestedDirections}}" wx:key="*this" class="report-line">{{item}}</text><text wx:if="{{!payload.suggestedDirections.length}}" class="muted">待顾问补充</text></view>
        <view class="panel candidate-panel"><view class="section-head"><text class="h2">候选学校与专业</text><text class="status status--warm">{{payload.candidatePrograms.length}} 项</text></view><view wx:for="{{payload.candidatePrograms}}" wx:key="institution" class="candidate"><text class="candidate__title">{{item.institution}} · {{item.program}}</text><text class="candidate__meta">入学 {{item.intakeYearLabel}} · 来源 {{item.sourceStatusLabel}} · 核验 {{item.verifiedAt}}</text><text class="candidate__body" user-select="true">官网来源：{{item.officialUrl}}</text><text class="candidate__body">学生接受情况：{{item.studentAcceptedLabel}}</text><text class="candidate__body">顾问匹配理由：{{item.matchReason}}</text><text class="candidate__body">申请要求：{{item.requirements}}</text><text wx:if="{{item.risksLabel}}" class="candidate__risk">风险：{{item.risksLabel}}</text></view><text wx:if="{{!payload.candidatePrograms.length}}" class="muted">暂无已核验项目</text></view>
        <view class="panel"><text class="h2">准备计划</text><text wx:for="{{payload.preparationPlan}}" wx:key="*this" class="report-line">{{item}}</text><text wx:if="{{!payload.preparationPlan.length}}" class="muted">待顾问补充</text></view>
        <view class="panel"><text class="h2">下一步与限制说明</text><text wx:for="{{payload.nextStepsAndLimitations}}" wx:key="*this" class="report-line">{{item}}</text><text wx:if="{{!payload.nextStepsAndLimitations.length}}" class="muted">请以顾问复核内容为准</text></view>
        <view class="panel report-export"><text class="h3">导出已开放版本</text><text class="muted">导出内容与当前已批准并开放的版本一致；草稿和未审核版本不能下载。</text><view class="report-export__actions"><button class="btn btn--outline" data-format="pdf" loading="{{exporting === 'pdf'}}" disabled="{{exporting}}" bindtap="exportReport">导出已开放报告 PDF</button><button class="btn btn--outline" data-format="xlsx" loading="{{exporting === 'xlsx'}}" disabled="{{exporting}}" bindtap="exportReport">导出院校表 XLSX</button></view></view>
      </block>
    </block>
  </view>
</view>
