APP_ENV=staging
PHOENIX_CORE_ENVIRONMENT=phoenix-core-staging
PHOENIX_CORE_READ_ONLY=true
PGHOST=/var/run/postgresql
PGPORT=5432
PGDATABASE=phoenix_core_staging
PGUSER=askwise_staging_ro
PGAPPNAME=askwise-staging-core-readcheck
PGCONNECT_TIMEOUT=5
PGOPTIONS="-c default_transaction_read_only=on -c statement_timeout=10000 -c lock_timeout=2000"
