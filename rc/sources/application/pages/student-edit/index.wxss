.student-page {
  background:
    radial-gradient(circle at 100% 0%, rgba(220, 181, 109, .21), transparent 29%),
    radial-gradient(circle at 0 94%, rgba(235, 210, 165, .2), transparent 24%),
    linear-gradient(180deg, #fffdf9 0%, #fcf8f2 56%, #f8f0e5 100%);
  color: #14243a;
  min-height: 100vh;
  overflow-x: hidden;
  padding: 46rpx 40rpx calc(68rpx + env(safe-area-inset-bottom));
  position: relative;
}

.profile-feather {
  height: 430rpx;
  opacity: .2;
  pointer-events: none;
  position: absolute;
  right: -150rpx;
  top: -30rpx;
  transform: rotate(-20deg);
  width: 500rpx;
  z-index: 0;
}

.profile-hero,
.form-grid,
.form-actions {
  position: relative;
  z-index: 1;
}

.profile-hero {
  padding-right: 46rpx;
}

.profile-hero__compass {
  display: block;
  height: 102rpx;
  margin-bottom: 18rpx;
  pointer-events: none;
  width: 102rpx;
}

.student-page .eyebrow {
  color: #89580c;
  display: block;
  font-size: 21rpx;
  letter-spacing: 4rpx;
}

.profile-title {
  color: #14243a;
  display: block;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 52rpx;
  font-weight: 600;
  line-height: 1.36;
  margin-top: 18rpx;
}

.profile-intro {
  color: #6f7375;
  display: block;
  font-size: 25rpx;
  line-height: 1.72;
  margin-top: 18rpx;
  max-width: 620rpx;
}

.form-grid {
  background: rgba(255, 253, 249, .95);
  border: 1rpx solid rgba(185, 132, 37, .23);
  border-radius: 30rpx;
  box-shadow: 0 14rpx 40rpx rgba(84, 57, 25, .08);
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 38rpx;
  padding: 8rpx 30rpx 32rpx;
}

.form-grid .field {
  min-width: 0;
  width: calc(50% - 10rpx);
}

.form-grid .form-grid__wide {
  width: 100%;
}

.student-page .field {
  margin-top: 28rpx;
}

.student-page .field__label {
  color: #25384a;
  display: block;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1.5;
  margin-bottom: 14rpx;
}

.student-page .field__required {
  color: #994b3d;
}

.student-page .input,
.student-page .textarea,
.student-page .picker {
  background: #fbf8f2;
  border: 1rpx solid #dfcba9;
  border-radius: 20rpx;
  color: #24384a;
  font-size: 28rpx;
  width: 100%;
}

.student-page .input,
.student-page .picker {
  height: 96rpx;
}

.student-page .input {
  padding: 0 24rpx;
}

.student-page .picker {
  align-items: center;
  display: flex;
  padding: 0 24rpx;
}

.student-page .textarea {
  line-height: 1.68;
  min-height: 190rpx;
  padding: 24rpx 26rpx;
}

.student-page .placeholder {
  color: #9c978f;
}

.student-page .input:focus,
.student-page .textarea:focus {
  background: #fffdf9;
  border-color: #b78122;
  box-shadow: 0 0 0 4rpx rgba(183, 129, 34, .08);
}

.student-page .form-actions {
  margin-top: 34rpx;
}

.student-page .btn {
  border-radius: 999rpx;
  font-size: 31rpx;
  font-weight: 600;
  min-height: 102rpx;
}

.student-page .btn--primary {
  background: linear-gradient(100deg, #a87419 0%, #875508 100%);
  box-shadow: 0 14rpx 30rpx rgba(123, 78, 8, .22);
  color: #fff;
}

.student-page .btn[disabled] {
  background: #e8dece;
  box-shadow: none;
  color: #978f83;
  opacity: 1;
}

.student-page .btn:active {
  opacity: .9;
  transform: scale(.987);
}

@media (max-width: 360px) {
  .form-grid .field {
    width: 100%;
  }
}

@media (prefers-reduced-motion: reduce) {
  .student-page .btn:active { transform: none; }
}
