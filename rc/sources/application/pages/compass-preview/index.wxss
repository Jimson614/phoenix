.preview-page { background: linear-gradient(180deg, #fbf8f2 0%, #fffdf9 52%, #f7efe1 100%); color: #102238; min-height: 100vh; overflow: hidden; position: relative; }
.preview-decoration { opacity: .34; pointer-events: none; position: absolute; z-index: 0; }
.preview-decoration--top { right: -150rpx; top: 44rpx; transform: rotate(-12deg); width: 470rpx; }
.preview-decoration--bottom { bottom: 70rpx; left: -190rpx; transform: rotate(170deg); width: 560rpx; }
.preview-brand,
.preview-state,
.preview-hero,
.preview-body,
.purchase-bar { position: relative; z-index: 1; }
.preview-brand { align-items: center; display: flex; justify-content: space-between; padding: 30rpx 34rpx 20rpx; }
.preview-brand__logo { display: block; height: auto; width: 270rpx; }
.preview-brand__product { align-items: center; color: #9f7122; display: flex; font-family: serif; font-size: 17rpx; font-weight: 700; letter-spacing: 1.5rpx; }
.preview-brand__product image { height: 42rpx; margin-right: 9rpx; width: 42rpx; }
.preview-state { align-items: center; background: rgba(255,253,249,.9); border: 1rpx solid #eadfce; border-radius: 32rpx; box-shadow: 0 20rpx 58rpx rgba(23,36,50,.075); display: flex; flex-direction: column; justify-content: center; margin: 34rpx 32rpx 70rpx; min-height: 360rpx; padding: 54rpx 44rpx; text-align: center; }
.preview-state::before { background: radial-gradient(circle, #fffdf8 0%, #eddbb7 100%); border: 1rpx solid #dec28c; border-radius: 50%; content: ''; height: 108rpx; margin-bottom: 30rpx; opacity: .92; width: 108rpx; }
.preview-state .h2, .preview-state .h3 { color: #102238; font-family: "Songti SC", serif; }
.preview-state .muted { color: #766f66; line-height: 1.75; margin: 18rpx 0 28rpx; }
.preview-state__button { margin-top: 18rpx; min-height: 44px; min-width: 280rpx; }
.preview-state--success { background: linear-gradient(150deg, rgba(255,253,249,.96), rgba(246,235,215,.94)); }
.preview-hero { align-items: center; background: transparent; color: #102238; display: flex; flex-direction: column; padding: 30rpx 40rpx 50rpx; text-align: center; }
.preview-hero::after { background: linear-gradient(90deg, transparent, #c89a41, transparent); bottom: 0; content: ''; height: 1rpx; left: 14%; position: absolute; right: 14%; }
.preview-hero--family { background: transparent; color: #102238; }
.preview-share { align-items: center; background: rgba(255,253,249,.88); border: 1rpx solid #e1cda8; border-radius: 999rpx; color: #8c641e; display: flex; font-size: 22rpx; height: 68rpx; justify-content: center; line-height: 1; min-height: 44px; padding: 0 24rpx; position: absolute; right: 34rpx; top: 6rpx; }
.preview-share::after { border: 0; }
.preview-hero__compass { height: 126rpx; margin-bottom: 18rpx; pointer-events: none; width: 126rpx; }
.preview-hero .eyebrow { color: #ae7d28; font-size: 19rpx; letter-spacing: 2.8rpx; }
.preview-hero__title { color: #102238; display: block; font-family: "Songti SC", serif; font-size: 56rpx; font-weight: 700; line-height: 1.32; margin-top: 18rpx; white-space: pre-line; }
.preview-hero__subtitle { color: #777069; display: block; font-size: 23rpx; line-height: 1.75; margin-top: 16rpx; max-width: 620rpx; }
.preview-hero--family .preview-hero__subtitle { color: #777069; }
.preview-meta { background: rgba(255,255,255,.72); border: 1rpx solid #eadfce; border-radius: 999rpx; color: #7d6a4a; display: flex; font-size: 20rpx; gap: 24rpx; margin-top: 24rpx; padding: 12rpx 22rpx; }
.preview-body { padding-bottom: 46rpx; }
.signal-card { background: rgba(255,253,249,.96); border: 1rpx solid #eadfce; border-radius: 28rpx; box-shadow: 0 18rpx 50rpx rgba(25,37,49,.065); overflow: hidden; padding: 34rpx; position: relative; }
.signal-card__feather { height: 230rpx; opacity: .48; pointer-events: none; position: absolute; right: -36rpx; top: -18rpx; transform: rotate(14deg); width: 170rpx; }
.signal-card__label, .signal-card__title, .signal-card__source { display: block; max-width: 82%; position: relative; z-index: 1; }
.signal-card__label { color: #233448; font-size: 22rpx; font-weight: 650; }
.signal-card__title { color: #a8741b; font-family: "Songti SC", serif; font-size: 43rpx; font-weight: 700; line-height: 1.42; margin-top: 18rpx; }
.signal-card__source { color: #596570; font-size: 23rpx; line-height: 1.75; margin-top: 18rpx; }
.snapshot-overview__title { color: #102238; display: block; font-size: 27rpx; font-weight: 650; margin-top: 34rpx; }
.snapshot-overview { display: grid; gap: 14rpx; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: 18rpx; }
.snapshot-overview__card { background: rgba(255,253,249,.9); border: 1rpx solid #eadfce; border-radius: 22rpx; min-width: 0; padding: 22rpx 15rpx; text-align: center; }
.snapshot-overview__mark { border: 2rpx solid #bd8a32; border-radius: 50%; height: 44rpx; margin: 0 auto 14rpx; position: relative; width: 44rpx; }
.snapshot-overview__mark::after { background: #d8ad58; border-radius: 50%; content: ''; height: 12rpx; left: 14rpx; position: absolute; top: 14rpx; width: 12rpx; }
.snapshot-overview__name, .snapshot-overview__value { display: block; overflow-wrap: anywhere; }
.snapshot-overview__name { color: #273849; font-size: 20rpx; font-weight: 650; line-height: 1.45; }
.snapshot-overview__value { color: #706d68; font-size: 18rpx; line-height: 1.5; margin-top: 8rpx; }
.snapshot-details { margin-top: 32rpx; }
.snapshot-details__title { color: #102238; display: block; font-family: "Songti SC", serif; font-size: 34rpx; font-weight: 700; }
.snapshot-section { background: rgba(255,253,249,.92); border: 1rpx solid #eadfce; border-radius: 26rpx; box-shadow: 0 13rpx 40rpx rgba(24,37,51,.05); margin-top: 20rpx; padding: 30rpx; }
.snapshot-section__head { align-items: flex-start; }
.snapshot-section__title { color: #102238; flex: 1; font-family: "Songti SC", serif; font-size: 33rpx; font-weight: 700; line-height: 1.45; }
.snapshot-section__source { background: #f2e7d2; border: 1rpx solid #e5d2ae; border-radius: 999rpx; color: #8b6727; flex: 0 0 auto; font-size: 18rpx; margin-left: 16rpx; padding: 8rpx 14rpx; }
.snapshot-section__lines { margin-top: 17rpx; }
.snapshot-line { color: #475765; display: flex; font-size: 25rpx; line-height: 1.8; padding: 5rpx 0; }
.snapshot-line__mark { color: #bd8a32; margin-right: 14rpx; }
.snapshot-section__empty { color: #948d84; display: block; font-size: 23rpx; margin-top: 17rpx; }
.readiness-card { background: linear-gradient(145deg, #10253a, #18364f); border: 1rpx solid rgba(218,182,107,.28); border-radius: 28rpx; box-shadow: 0 20rpx 48rpx rgba(13,31,50,.18); color: white; margin-top: 28rpx; padding: 32rpx; }
.readiness-card__label, .readiness-card__title, .readiness-card__copy, .readiness-card__reason { display: block; }
.readiness-card__label { color: #e3c47d; font-size: 18rpx; letter-spacing: 2rpx; }
.readiness-card__title { color: #fffdf7; font-family: "Songti SC", serif; font-size: 34rpx; font-weight: 700; margin-top: 10rpx; }
.readiness-card__copy { color: rgba(255,255,255,.8); font-size: 25rpx; line-height: 1.75; margin-top: 12rpx; }
.readiness-card__divider { background: rgba(226,193,119,.24); height: 1rpx; margin: 25rpx 0; }
.readiness-card__reason { color: rgba(255,255,255,.65); font-size: 22rpx; line-height: 1.65; margin-top: 7rpx; }
.boundary-note { background: rgba(245,238,226,.9); border: 1rpx solid #e7dac5; border-radius: 20rpx; color: #766f66; font-size: 21rpx; line-height: 1.75; margin-top: 26rpx; padding: 24rpx; text-align: center; }
.snapshot-invite { align-items: flex-start; border-top: 1rpx solid #e6d8c2; display: flex; flex-direction: column; margin-top: 34rpx; padding: 30rpx 10rpx 2rpx; }
.snapshot-invite__title, .snapshot-invite__copy, .snapshot-invite__flow, .snapshot-invite__boundary, .snapshot-invite__price, .snapshot-invite__warning { display: block; }
.snapshot-invite__title { color: #102238; font-family: "Songti SC", serif; font-size: 31rpx; font-weight: 700; line-height: 1.5; }
.snapshot-invite__copy { color: #6f716f; font-size: 22rpx; line-height: 1.7; margin-top: 8rpx; }
.snapshot-invite__flow { background: #fbf4e7; border: 1rpx solid #ead7b6; border-radius: 16rpx; color: #875f20; font-size: 20rpx; line-height: 1.65; margin-top: 16rpx; padding: 14rpx 16rpx; }
.snapshot-invite__boundary { color: #817a70; font-size: 19rpx; line-height: 1.62; margin-top: 11rpx; }
.snapshot-invite__price { color: #966313; font-size: 22rpx; line-height: 1.6; margin-top: 13rpx; }
.snapshot-invite__warning { color: var(--pn-danger, #984b40); font-size: 21rpx; line-height: 1.55; margin-top: 13rpx; }
.snapshot-cta { margin-top: 22rpx; min-height: 44px; }
.snapshot-cta.btn--primary { background: linear-gradient(105deg, #d5aa4d, #b77b1d); box-shadow: 0 14rpx 34rpx rgba(181,126,30,.25); color: #fff; }
.preview-card { background: rgba(255,253,249,.92); border: 1rpx solid #eadfce; border-radius: 24rpx; box-shadow: 0 12rpx 36rpx rgba(23,36,49,.045); margin-top: 20rpx; padding: 28rpx; }
.preview-card--lead { border-left: 5rpx solid #c79843; }
.preview-card__label, .preview-card__copy { display: block; }
.preview-card__label { color: #a47527; font-size: 19rpx; font-weight: 650; letter-spacing: 2rpx; }
.preview-card__copy { color: #2c3c4b; font-size: 26rpx; line-height: 1.8; margin-top: 12rpx; }
.preview-pair { display: grid; gap: 16rpx; grid-template-columns: 1fr 1fr; }
.free-analysis-card { background: linear-gradient(145deg, #f1f5f5, #fffdf9); border: 1rpx solid #d6e1e1; border-radius: 25rpx; box-shadow: 0 12rpx 36rpx rgba(34,67,71,.04); margin-top: 24rpx; padding: 28rpx; }
.free-analysis-card__eyebrow, .free-analysis-card__title, .free-analysis-card__copy { display: block; }
.free-analysis-card__eyebrow { color: #56777a; font-size: 18rpx; letter-spacing: 2rpx; }
.free-analysis-card__title { color: #17344b; font-family: "Songti SC", serif; font-size: 32rpx; font-weight: 700; margin-top: 10rpx; }
.free-analysis-card__copy { color: #607073; font-size: 22rpx; line-height: 1.75; margin-top: 12rpx; }
.free-analysis-card .btn { margin-top: 20rpx; min-height: 44px; }
.locked-report { border-top: 1rpx solid #e3d9c9; margin-top: 42rpx; padding-top: 34rpx; }
.locked-report--strict { align-items: center; background: rgba(255,253,249,.92); border: 1rpx solid #eadfce; border-radius: 30rpx; box-shadow: 0 20rpx 58rpx rgba(24,37,51,.075); display: flex; flex-direction: column; margin-top: 12rpx; padding: 46rpx 28rpx; text-align: center; }
.locked-report__icon { align-items: center; background: radial-gradient(circle, #fffdf8 0%, #f2e4ca 100%); border: 1rpx solid #dec28d; border-radius: 50%; display: flex; height: 112rpx; justify-content: center; width: 112rpx; }
.locked-report__icon image { height: 82rpx; width: 82rpx; }
.visually-hidden { height: 1px; margin: -1px; overflow: hidden; padding: 0; position: absolute; width: 1px; }
.locked-report__title { color: #102238; display: block; margin-top: 26rpx; }
.locked-report__copy { color: #667078; display: block; font-size: 24rpx; line-height: 1.85; margin-top: 17rpx; }
.locked-report__mark { background: #eee7dc; border-radius: 999rpx; color: #827566; font-size: 18rpx; padding: 8rpx 14rpx; }
.locked-row { align-items: center; border-bottom: 1rpx solid #ebe3d7; color: #263642; display: grid; font-size: 25rpx; gap: 18rpx; grid-template-columns: 46rpx 1fr 36rpx; padding: 24rpx 0; }
.locked-row text:first-child { color: #ae863b; font-family: serif; }
.locked-row__icon { height: 34rpx; opacity: .68; pointer-events: none; width: 34rpx; }
.locked-report__note { color: #77736d; display: block; font-size: 21rpx; line-height: 1.75; margin-top: 24rpx; }
.locked-product { background: linear-gradient(145deg, #fbf5e9, #f4e7ce); border: 1rpx solid #e3cda3; border-radius: 24rpx; margin-top: 28rpx; padding: 28rpx; width: 100%; }
.locked-product__name, .locked-product__price, .locked-product__type { display: block; }
.locked-product__name { color: #263642; font-size: 25rpx; }
.locked-product__price { color: #9b6d20; font-family: serif; font-size: 48rpx; font-weight: 700; margin-top: 10rpx; }
.locked-product__type { color: #8a847c; font-size: 20rpx; margin-top: 5rpx; }
.basis-note { background: #f2eee7; border-radius: 18rpx; color: #8a847c; font-size: 19rpx; line-height: 1.7; margin-top: 30rpx; padding: 22rpx; }
.basis-note text { display: block; }
.purchase-bar-placeholder { height: 178rpx; }
.purchase-bar { align-items: center; background: rgba(255,253,249,.985); border-top: 1rpx solid rgba(184,135,46,.19); bottom: 0; box-shadow: 0 -14rpx 42rpx rgba(13,27,42,.09); box-sizing: border-box; display: flex; justify-content: space-between; left: 0; padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom)); position: fixed; right: 0; z-index: 20; }
.purchase-bar__summary { flex: 1; min-width: 0; }
.purchase-bar__price, .purchase-bar__type { display: block; }
.purchase-bar__price { color: #9b6d20; font-family: serif; font-size: 40rpx; font-weight: 700; }
.purchase-bar__type { color: #81786e; font-size: 18rpx; }
.purchase-bar__button { background: linear-gradient(105deg, #d7ad51, #b67a1c); box-shadow: 0 14rpx 34rpx rgba(181,126,30,.28); color: #fff; margin: 0 0 0 18rpx; min-height: 44px; min-width: 310rpx; }
.purchase-bar__button[disabled] { background: #d9d2c7; box-shadow: none; color: #8f887e; }

@media (max-width: 430px) {
  .preview-brand { padding-left: 28rpx; padding-right: 28rpx; }
  .preview-brand__logo { width: 238rpx; }
  .preview-brand__product text { display: none; }
  .preview-brand__product image { height: 48rpx; margin: 0; width: 48rpx; }
  .preview-hero__title { font-size: 49rpx; }
  .preview-pair { grid-template-columns: 1fr; }
  .snapshot-section__head { align-items: flex-start; flex-direction: column; }
  .snapshot-section__source { margin: 12rpx 0 0; }
}

@media (max-width: 360px) {
  .preview-brand__logo { width: 215rpx; }
  .preview-hero { padding-left: 28rpx; padding-right: 28rpx; }
  .preview-hero__title { font-size: 44rpx; }
  .preview-share { right: 24rpx; top: 0; }
  .signal-card { padding: 28rpx; }
  .signal-card__title { font-size: 36rpx; }
  .snapshot-overview { gap: 8rpx; }
  .snapshot-overview__card { padding: 18rpx 8rpx; }
  .snapshot-overview__name { font-size: 18rpx; }
  .snapshot-overview__value { font-size: 16rpx; }
  .purchase-bar { align-items: stretch; flex-direction: column; }
  .purchase-bar__summary { align-items: baseline; display: flex; justify-content: space-between; margin-bottom: 14rpx; }
  .purchase-bar__button { margin: 0; min-width: 0; width: 100%; }
  .purchase-bar-placeholder { height: 250rpx; }
}
