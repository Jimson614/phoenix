page {
  --navy: #0d1b2a;
  --navy-soft: #23364a;
  --gold: #c8a24a;
  --gold-deep: #ad7d29;
  --ivory: #f8f3ea;
  --paper: #fffdf9;
  --ink: #17212b;
  --muted: #6f7479;
  --line: #e7dece;
  --sage: #75877a;
  background: var(--ivory);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  overflow-x: hidden;
}

view, text, button, input, textarea, picker { box-sizing: border-box; }

.page {
  min-height: 100vh;
  padding: 32rpx 32rpx 64rpx;
  padding-bottom: calc(64rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(64rpx + env(safe-area-inset-bottom));
}
.page--paper { background: var(--paper); }
.eyebrow { color: var(--gold-deep); font-size: 22rpx; font-weight: 600; letter-spacing: 3rpx; text-transform: uppercase; }
.h1 { color: var(--navy); font-family: "Songti SC", serif; font-size: 54rpx; font-weight: 700; line-height: 1.25; }
.h2 { color: var(--navy); font-family: "Songti SC", serif; font-size: 38rpx; font-weight: 700; line-height: 1.3; }
.h3 { color: var(--navy); font-size: 30rpx; font-weight: 650; }
.body { color: var(--ink); font-size: 28rpx; line-height: 1.75; }
.muted { color: var(--muted); font-size: 25rpx; line-height: 1.65; }
.gold { color: var(--gold-deep); }
.section { margin-top: 42rpx; }
.section-head { align-items: flex-end; display: flex; justify-content: space-between; margin-bottom: 20rpx; }
.panel { background: rgba(255,253,249,.94); border: 1rpx solid rgba(200,162,74,.16); border-radius: 28rpx; box-shadow: 0 16rpx 42rpx rgba(13,27,42,.055); padding: 30rpx; }
.panel + .panel { margin-top: 20rpx; }
.panel--navy { background: linear-gradient(145deg, #14273a, #0d1b2a); border: 0; color: #fff; }
.panel--gold { background: linear-gradient(145deg, #f5ead2, #fffaf0); border-color: rgba(183,138,55,.22); }
.divider { background: var(--line); height: 1rpx; margin: 26rpx 0; }
.row { align-items: center; display: flex; }
.row--between { justify-content: space-between; }
.grow { flex: 1; }
.tag { background: #f3ecdf; border-radius: 999rpx; color: var(--navy-soft); display: inline-flex; font-size: 23rpx; margin: 0 12rpx 12rpx 0; padding: 12rpx 20rpx; }
.tag--active { background: var(--navy); color: #fff; }
.btn { align-items: center; border-radius: 999rpx; display: flex; font-size: 28rpx; font-weight: 600; height: 92rpx; justify-content: center; line-height: 1; margin: 0; padding: 0 34rpx; }
.btn::after { border: 0; }
.btn--primary { background: var(--navy); color: #fff; }
.btn--gold { background: var(--gold); color: var(--navy); }
.btn--outline { background: transparent; border: 1rpx solid rgba(13,27,42,.28); color: var(--navy); }
.btn--text { background: transparent; color: var(--gold-deep); height: 70rpx; padding: 0; }
.btn + .btn { margin-top: 18rpx; }
.field { margin-top: 28rpx; }
.field__label { color: var(--navy); display: block; font-size: 25rpx; font-weight: 600; margin-bottom: 14rpx; }
.field__required { color: #a6604e; }
.input, .textarea, .picker { background: #fff; border: 1rpx solid var(--line); border-radius: 18rpx; color: var(--ink); font-size: 28rpx; padding: 24rpx; width: 100%; }
.input, .picker { height: 90rpx; }
.textarea { min-height: 180rpx; }
.placeholder { color: #aaa39a; }
.form-actions { margin-top: 48rpx; }
.empty { padding: 64rpx 24rpx; text-align: center; }
.empty__mark { color: var(--gold); font-family: serif; font-size: 70rpx; margin-bottom: 12rpx; }
.safe-bottom { height: constant(safe-area-inset-bottom); height: env(safe-area-inset-bottom); }
.chevron { color: var(--gold-deep); font-size: 32rpx; }
.status { background: #edf2ee; border-radius: 999rpx; color: #55705b; font-size: 21rpx; padding: 9rpx 15rpx; }
.status--warm { background: #f7ecdc; color: #976e2f; }
