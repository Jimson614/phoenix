.compass-hero { background: linear-gradient(145deg, #f0e3c7, #fffaf0); padding: 56rpx 36rpx 48rpx; }
.compass-hero__title { color: #0d1b2a; display: block; font-family: serif; font-size: 47rpx; font-weight: 700; line-height: 1.4; margin-top: 22rpx; white-space: pre-line; }
.compass-hero__copy { color: #5d6063; display: block; font-size: 25rpx; line-height: 1.8; margin-top: 24rpx; }
.compass-hero__student { align-items: center; border-top: 1rpx solid rgba(13,27,42,.12); display: flex; margin-top: 34rpx; padding-top: 28rpx; }
.compass-hero__avatar { align-items: center; background: #0d1b2a; border-radius: 50%; color: #f0d99e; display: flex; font-family: serif; height: 70rpx; justify-content: center; margin-right: 18rpx; width: 70rpx; }
.compass-hero__name, .compass-hero__meta { display: block; }
.compass-hero__name { color: #0d1b2a; font-weight: 650; }
.compass-hero__meta { color: #77736d; font-size: 22rpx; margin-top: 5rpx; }
.compass-body { padding-top: 42rpx; }
.compass-path { margin-bottom: 42rpx; }
.compass-path__item { display: flex; padding: 22rpx 0; }
.compass-path__item > text { color: #b78a37; font-family: serif; font-size: 22rpx; margin-right: 28rpx; padding-top: 4rpx; }
.compass-path__item view text { display: block; }
.compass-path__item view text:first-child { color: #0d1b2a; font-size: 29rpx; font-weight: 650; }
.compass-path__item view text:last-child { color: #7a7a77; font-size: 23rpx; margin-top: 7rpx; }
.compass-time { color: #928a80; display: block; font-size: 21rpx; margin-top: 18rpx; text-align: center; }
.history { border-top: 1rpx solid #e7dece; padding-top: 36rpx; }
.history__item { align-items: center; border-bottom: 1rpx solid #e7dece; display: flex; justify-content: space-between; padding: 24rpx 0; }
.history__date, .history__title { display: block; }
.history__date { color: #a37c36; font-size: 20rpx; }
.history__title { color: #0d1b2a; font-size: 27rpx; margin-top: 6rpx; }
