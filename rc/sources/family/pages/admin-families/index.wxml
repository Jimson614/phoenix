<view class="advisor-list-page">
  <view class="advisor-list__header">
    <view><text class="eyebrow">PHOENIX ADVISOR</text><text class="advisor-list__title">家庭陪伴工作台</text></view>
    <text class="advisor-list__logout" bindtap="logout">退出</text>
  </view>

  <view class="advisor-list__summary">
    <text class="advisor-list__number">{{allFamilies.length || 0}}</text>
    <text class="advisor-list__summary-label">个家庭成长档案</text>
    <text class="advisor-list__summary-note">先理解家庭，再开始一次跟进。</text>
  </view>

  <view class="page advisor-list__body">
    <input class="advisor-search" value="{{query}}" placeholder="搜索家庭、家长或地区" bindinput="search" />
    <view wx:if="{{families.length}}" class="family-list">
      <view wx:for="{{families}}" wx:key="id" class="family-row" data-id="{{item.id}}" bindtap="open">
        <view class="family-row__top"><text class="family-row__name">{{item.family_name}}</text><text class="status {{item.hasRequest ? 'status--warm' : ''}}">{{item.followStatus}}</text></view>
        <text class="family-row__meta">{{item.parent_name}} · {{item.location || '地区待完善'}} · {{item.students.length}} 位孩子</text>
        <view class="family-row__bottom"><text>{{item.reportCount}} 份成长报告</text><text>更新于 {{item.lastUpdate}} ›</text></view>
      </view>
    </view>
    <view wx:else class="empty"><view class="empty__mark">◌</view><text class="h3">暂无家庭档案</text><text class="muted empty-copy">家庭端完成档案后，会在这里出现。</text></view>
  </view>
</view>
