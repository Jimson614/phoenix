.report__cover { background: linear-gradient(150deg, #10263b, #0b1927); color: #fff; min-height: 520rpx; overflow: hidden; padding: 70rpx 38rpx 46rpx; position: relative; }
.report__cover::after { border: 1rpx solid rgba(200,162,74,.2); border-radius: 50%; content: ''; height: 460rpx; position: absolute; right: -220rpx; top: 20rpx; width: 460rpx; }
.report__name { display: block; font-family: serif; font-size: 62rpx; font-weight: 700; line-height: 1.3; margin-top: 38rpx; position: relative; white-space: pre-line; z-index: 1; }
.report__date { color: rgba(255,255,255,.55); display: block; font-size: 21rpx; margin-top: 28rpx; }
.report__seal { align-items: center; border: 1rpx solid rgba(213,183,111,.45); border-radius: 50%; bottom: 45rpx; display: flex; flex-direction: column; height: 110rpx; justify-content: center; position: absolute; right: 45rpx; width: 110rpx; }
.report__seal text:first-child { color: #e2c986; font-family: serif; font-size: 34rpx; }
.report__seal text:last-child { color: rgba(255,255,255,.5); font-size: 13rpx; letter-spacing: 2rpx; }
.report__body { background: #fffdf9; }
.report__intro { color: #38434d; font-family: serif; font-size: 29rpx; line-height: 1.9; padding: 24rpx 12rpx 48rpx 40rpx; position: relative; }
.report__quote { color: #dbc28b; font-size: 100rpx; left: -8rpx; line-height: 1; position: absolute; top: 4rpx; }
.report-section { border-top: 1rpx solid #e7dece; padding: 40rpx 0; }
.report-section__number, .report-section__label, .report-section__title, .report-section__copy { display: block; }
.report-section__number { color: #c8a24a; float: right; font-family: serif; font-size: 26rpx; }
.report-section__label { color: #a47b34; font-size: 19rpx; letter-spacing: 3rpx; }
.report-section__title { color: #0d1b2a; font-family: serif; font-size: 37rpx; font-weight: 700; line-height: 1.5; margin-top: 14rpx; }
.report-section__copy { color: #5d6266; font-size: 26rpx; line-height: 1.8; margin-top: 16rpx; }
.report-highlight { background: #f5eee2; border-left: 5rpx solid #c8a24a; margin-top: 26rpx; padding: 23rpx; }
.report-highlight text { display: block; }
.report-highlight text:first-child { color: #9a742f; font-size: 20rpx; letter-spacing: 2rpx; }
.report-highlight text:last-child { color: #0d1b2a; font-size: 29rpx; font-weight: 650; margin-top: 8rpx; }
.action-card { background: #11263a; border-radius: 30rpx; color: #fff; margin-top: 24rpx; padding: 34rpx; }
.action-card__label, .action-card__title, .action-card__copy { display: block; }
.action-card__label { color: #d9bd7b; font-size: 19rpx; letter-spacing: 3rpx; }
.action-card__title { font-family: serif; font-size: 38rpx; font-weight: 700; margin-top: 12rpx; }
.action-card__copy { color: rgba(255,255,255,.75); font-size: 26rpx; line-height: 1.8; margin-top: 16rpx; }
.report-note { color: #9a958e; font-size: 20rpx; line-height: 1.6; margin-top: 28rpx; text-align: center; }
.report-error { padding-top: 150rpx; text-align: center; }
.report-error__title, .report-error__copy { display: block; }
.report-error__copy { margin-top: 20rpx; }
.report-error__button { margin-top: 48rpx; }
