.agent-page {
  background:
    radial-gradient(circle at 100% 1%, rgba(220, 181, 109, .2), transparent 27%),
    radial-gradient(circle at 0 88%, rgba(236, 211, 167, .2), transparent 23%),
    linear-gradient(180deg, #fffdf9 0%, #fcf8f2 58%, #f8f0e5 100%);
  color: #14243a;
  min-height: 100vh;
  overflow-x: hidden;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  position: relative;
}

.agent-page__feather {
  opacity: .18;
  pointer-events: none;
  position: absolute;
  z-index: 0;
}

.agent-page__feather--top {
  height: 370rpx;
  right: -132rpx;
  top: -12rpx;
  transform: rotate(-20deg);
  width: 440rpx;
}

.agent-page__feather--bottom {
  bottom: 22rpx;
  height: 430rpx;
  left: -188rpx;
  opacity: .12;
  transform: rotate(160deg);
  width: 510rpx;
}

.agent-hero,
.agent-state,
.agent-body,
.agent-conversation,
.management-card,
.back-button,
.agent-page > .safe-bottom {
  position: relative;
  z-index: 1;
}

.agent-hero {
  border-bottom: 1rpx solid rgba(185, 132, 37, .16);
  padding: 52rpx 48rpx 44rpx;
  text-align: center;
}

.agent-hero__compass {
  display: block;
  height: 112rpx;
  margin: 0 auto 17rpx;
  pointer-events: none;
  width: 112rpx;
}

.agent-hero .eyebrow {
  color: #89580c;
  display: block;
  font-size: 20rpx;
  letter-spacing: 4rpx;
}

.agent-hero__title {
  color: #14243a;
  display: block;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 47rpx;
  font-weight: 600;
  line-height: 1.4;
  margin-top: 20rpx;
}

.agent-hero__copy {
  color: #6f7375;
  display: block;
  font-size: 23rpx;
  line-height: 1.72;
  margin: 18rpx auto 0;
  max-width: 640rpx;
}

.agent-state {
  align-items: center;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 52vh;
  padding: 64rpx 48rpx;
  text-align: center;
}

.agent-state__compass {
  display: block;
  height: 132rpx;
  margin-bottom: 24rpx;
  pointer-events: none;
  width: 132rpx;
}

.agent-state__error-mark {
  align-items: center;
  background: #fbebe6;
  border: 1rpx solid #e2bdb2;
  border-radius: 50%;
  color: #97483b;
  display: flex;
  font-family: serif;
  font-size: 52rpx;
  height: 118rpx;
  justify-content: center;
  margin-bottom: 24rpx;
  width: 118rpx;
}

.agent-state .h3 {
  color: #14243a;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 37rpx;
  font-weight: 600;
  line-height: 1.45;
}

.agent-state .muted {
  color: #747570;
  display: block;
  line-height: 1.72;
  margin: 18rpx 0 30rpx;
  max-width: 590rpx;
}

.agent-body.page {
  min-height: 0;
  padding: 34rpx 40rpx 52rpx;
}

.unavailable-card,
.consent-card {
  background: rgba(255, 253, 249, .95);
  border: 1rpx solid rgba(185, 132, 37, .23);
  border-radius: 30rpx;
  box-shadow: 0 14rpx 40rpx rgba(84, 57, 25, .08);
  padding: 34rpx;
}

.unavailable-card .h3 {
  color: #14243a;
  display: block;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 36rpx;
  font-weight: 600;
}

.unavailable-card .muted {
  color: #686d70;
  display: block;
  font-size: 24rpx;
  line-height: 1.74;
  margin-top: 18rpx;
}

.status-copy {
  background: #fbebe6;
  border: 1rpx solid #e9c7bd;
  border-radius: 18rpx;
  color: #8b463a;
  display: block;
  font-size: 23rpx;
  line-height: 1.68;
  margin-top: 22rpx;
  padding: 19rpx 20rpx;
}

.consent-card .h2 {
  color: #14243a;
  display: block;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1.48;
}

.consent-card > .muted {
  color: #696b69;
  display: block;
  font-size: 23rpx;
  line-height: 1.78;
  margin-bottom: 24rpx;
}

.consent-list {
  background: #faf3e8;
  border: 1rpx solid #ecddc5;
  border-radius: 22rpx;
  color: #46515e;
  font-size: 24rpx;
  line-height: 1.78;
  margin: 26rpx 0 22rpx;
  padding: 24rpx 26rpx;
}

.consent-list text {
  display: block;
}

.consent-list text + text {
  margin-top: 9rpx;
}

.consent-check {
  background: rgba(255, 255, 255, .72);
  border: 1rpx solid #dfcba9;
  border-radius: 22rpx;
  margin-bottom: 28rpx;
  padding: 8rpx 24rpx;
}

.consent-check label {
  align-items: flex-start;
  color: #3f4b58;
  display: flex;
  font-size: 24rpx;
  line-height: 1.68;
  min-height: 88rpx;
  padding: 20rpx 0;
}

.consent-check label + label {
  border-top: 1rpx solid #eee3d2;
}

.consent-check checkbox {
  flex: 0 0 auto;
  margin-right: 12rpx;
  transform: scale(.84);
  transform-origin: top left;
}

.agent-conversation {
  padding: 28rpx 0 42rpx;
}

.quota-bar {
  align-items: center;
  background: rgba(250, 243, 232, .92);
  border: 1rpx solid #e9d8bd;
  border-radius: 22rpx;
  color: #5d5b55;
  display: flex;
  flex-wrap: wrap;
  font-size: 22rpx;
  gap: 12rpx;
  justify-content: space-between;
  margin: 0 32rpx 20rpx;
  padding: 18rpx 22rpx;
}

.quota-bar .status {
  background: #f3e4c8;
  color: #80520c;
  flex: 0 0 auto;
  font-size: 20rpx;
}

.message-list {
  height: 720rpx;
  padding: 12rpx 32rpx 28rpx;
  width: 100%;
}

.history-loading {
  color: #85847f;
  font-size: 22rpx;
  line-height: 1.65;
  padding: 34rpx 22rpx;
  text-align: center;
}

.conversation-empty {
  align-items: center;
  color: #6f716e;
  display: flex;
  flex-direction: column;
  font-size: 23rpx;
  line-height: 1.82;
  padding: 64rpx 28rpx;
  text-align: center;
}

.conversation-empty__emblem {
  height: 138rpx;
  margin-bottom: 18rpx;
  position: relative;
  width: 138rpx;
}

.conversation-empty__compass {
  height: 138rpx;
  left: 0;
  pointer-events: none;
  position: absolute;
  top: 0;
  width: 138rpx;
}

.conversation-empty__mark {
  align-items: center;
  color: #89580c;
  display: flex;
  font-family: serif;
  font-size: 32rpx;
  height: 100%;
  justify-content: center;
  position: relative;
  width: 100%;
}

.conversation-empty .h3 {
  color: #14243a;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 14rpx;
}

.message {
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  padding: 26rpx;
}

.message--user {
  background: linear-gradient(145deg, #20364b 0%, #14243a 100%);
  box-shadow: 0 12rpx 26rpx rgba(20, 36, 58, .12);
  color: #fff;
  margin-left: 70rpx;
}

.message--assistant {
  background: rgba(255, 253, 249, .96);
  border: 1rpx solid #e8d9c2;
  box-shadow: 0 12rpx 30rpx rgba(84, 57, 25, .06);
  color: #334352;
  margin-right: 26rpx;
}

.message__role {
  color: #89580c;
  display: block;
  font-size: 20rpx;
  font-weight: 650;
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
}

.message--user .message__role {
  color: #e7c880;
}

.message__answer {
  display: block;
  font-size: 26rpx;
  line-height: 1.78;
  white-space: pre-wrap;
}

.message--assistant .message__answer {
  color: #334352;
}

.reply-block {
  background: #faf3e8;
  border: 1rpx solid #eee1cc;
  border-radius: 19rpx;
  margin-top: 20rpx;
  padding: 20rpx 22rpx;
}

.reply-block text {
  color: #4b5661;
  display: block;
  font-size: 23rpx;
  line-height: 1.76;
}

.reply-block text + text {
  margin-top: 5rpx;
}

.reply-block__title {
  color: #14243a !important;
  font-size: 25rpx !important;
  font-weight: 650;
  margin-bottom: 8rpx;
}

.reply-block--action {
  border-left: 6rpx solid #b78122;
}

.reply-block--limits {
  background: #f4f1ec;
  border-color: #e6e0d7;
}

.trusted-sources {
  border-top: 1rpx solid #e8dbc7;
  margin-top: 22rpx;
  padding-top: 20rpx;
}

.trusted-source {
  align-items: flex-start;
  display: flex;
  margin-top: 14rpx;
}

.trusted-source__alias {
  background: #14243a;
  border-radius: 9rpx;
  color: #fff;
  flex: 0 0 auto;
  font-size: 19rpx;
  margin-right: 13rpx;
  min-width: 46rpx;
  padding: 6rpx 9rpx;
  text-align: center;
}

.trusted-source__name,
.trusted-source__detail {
  display: block;
}

.trusted-source__name {
  color: #344555;
  font-size: 23rpx;
  line-height: 1.5;
}

.trusted-source__detail {
  color: #85847f;
  font-size: 20rpx;
  line-height: 1.55;
  margin-top: 4rpx;
}

.guardian-attention {
  background: #fbebe6;
  border: 1rpx solid #e9c7bd;
  border-radius: 18rpx;
  color: #8b463a;
  display: block;
  font-size: 23rpx;
  line-height: 1.68;
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
}

.run-state {
  background: #faf2e5;
  border: 1rpx solid #e9d5b5;
  border-radius: 20rpx;
  color: #6d582f;
  font-size: 23rpx;
  line-height: 1.6;
  margin: 0 32rpx 20rpx;
  padding: 18rpx 20rpx;
  text-align: center;
}

.run-state--BLOCKED,
.run-state--FAILED {
  background: #fbebe6;
  border-color: #e9c7bd;
  color: #8b463a;
}

.run-refresh {
  background: transparent;
  color: #80520c;
  font-size: 22rpx;
  line-height: 1;
  margin: 12rpx auto 0;
  min-height: 72rpx;
  padding: 16rpx 24rpx;
}

.run-refresh::after {
  border: 0;
}

.composer {
  background: rgba(255, 253, 249, .96);
  border: 1rpx solid #e7d6bb;
  border-radius: 28rpx;
  box-shadow: 0 14rpx 36rpx rgba(84, 57, 25, .08);
  margin: 0 32rpx;
  padding: 26rpx;
}

.composer__input {
  background: #fbf7f0;
  border: 1rpx solid #dfcba9;
  border-radius: 20rpx;
  color: #24384a;
  font-size: 26rpx;
  line-height: 1.65;
  min-height: 164rpx;
  padding: 22rpx;
  width: 100%;
}

.composer__input[disabled] {
  background: #f1ede7;
  color: #8d8981;
}

.composer__meta {
  color: #8b8983;
  display: flex;
  flex-wrap: wrap;
  font-size: 20rpx;
  gap: 8rpx 18rpx;
  justify-content: space-between;
  line-height: 1.55;
  margin: 12rpx 2rpx 20rpx;
}

.conversation-actions {
  padding: 8rpx 32rpx 0;
}

.conversation-actions .btn {
  margin-top: 12rpx;
}

.danger {
  color: #98483c !important;
}

.management-card.page {
  background: rgba(255, 253, 249, .76);
  border: 1rpx solid #e7d6bb;
  border-radius: 28rpx;
  box-shadow: 0 12rpx 32rpx rgba(84, 57, 25, .06);
  margin: 4rpx 32rpx 0;
  min-height: 0;
  padding: 30rpx;
}

.management-card .h3 {
  color: #14243a;
  display: block;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 34rpx;
  font-weight: 600;
}

.management-card .muted {
  color: #737570;
  display: block;
  font-size: 22rpx;
  line-height: 1.68;
  margin: 12rpx 0 18rpx;
}

.management-row {
  align-items: center;
  border-top: 1rpx solid #ebe0d0;
  display: flex;
  gap: 18rpx;
  justify-content: space-between;
  min-height: 94rpx;
  padding: 16rpx 0;
}

.management-row text {
  color: #4c5862;
  display: block;
  font-size: 22rpx;
  line-height: 1.5;
}

.management-row__id {
  color: #8b8983 !important;
  font-size: 19rpx !important;
  margin-top: 5rpx;
  max-width: 450rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.management-delete {
  align-items: center;
  background: #fbebe6;
  border-radius: 999rpx;
  color: #98483c;
  display: flex;
  flex: 0 0 auto;
  font-size: 22rpx;
  justify-content: center;
  line-height: 1;
  margin: 0;
  min-height: 72rpx;
  padding: 0 24rpx;
}

.management-delete::after {
  border: 0;
}

.back-button {
  margin: 18rpx auto 30rpx;
}

.agent-page .btn {
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  min-height: 96rpx;
}

.agent-page .btn--primary {
  background: linear-gradient(100deg, #a87419 0%, #875508 100%);
  box-shadow: 0 14rpx 30rpx rgba(123, 78, 8, .22);
  color: #fff;
}

.agent-page .btn--outline {
  background: rgba(255, 253, 249, .82);
  border: 1rpx solid #b9852b;
  color: #80520c;
}

.agent-page .btn--text {
  color: #80520c;
}

.agent-page .btn[disabled] {
  background: #e8dece;
  box-shadow: none;
  color: #978f83;
  opacity: 1;
}

.agent-page .btn:active,
.management-delete:active,
.run-refresh:active {
  opacity: .88;
  transform: scale(.987);
}

@media (prefers-reduced-motion: reduce) {
  .agent-page .btn:active,
  .management-delete:active,
  .run-refresh:active { transform: none; }
}
