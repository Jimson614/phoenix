.advisor-list-page {
  background:
    radial-gradient(circle at 96% 0, rgba(223, 187, 116, .2), transparent 27%),
    linear-gradient(180deg, #fffdf9 0%, #faf5ec 48%, #f6efe4 100%);
  min-height: 100vh;
  overflow: hidden;
  position: relative;
}
.advisor-list__feather { opacity: .14; pointer-events: none; position: absolute; right: -150rpx; top: 10rpx; transform: rotate(22deg); width: 420rpx; }
.advisor-list__header { align-items: center; display: flex; justify-content: space-between; padding: 32rpx 34rpx 25rpx; position: relative; z-index: 1; }
.advisor-list__brand { align-items: center; display: flex; min-width: 0; }
.advisor-list__brand brand-mark { flex-shrink: 0; margin-right: 24rpx; }
.advisor-list__brand .eyebrow { display: block; font-size: 17rpx; }
.advisor-list__title { color: #11253a; display: block; font-family: "Songti SC", serif; font-size: 32rpx; font-weight: 700; margin-top: 6rpx; }
.advisor-list__logout { background: rgba(255,253,249,.82); border: 1rpx solid rgba(23,42,61,.18); border-radius: 999rpx; color: #5f6670; font-size: 22rpx; height: 72rpx; line-height: 70rpx; margin: 0 0 0 20rpx; min-height: 44px; padding: 0 24rpx; }
.advisor-list__logout::after { border: 0; }

.advisor-list__summary { background: linear-gradient(145deg, #162c41, #0c1d2e); border-radius: 0 0 42rpx 42rpx; color: #fff; overflow: hidden; padding: 42rpx 38rpx 38rpx; position: relative; }
.advisor-list__summary-orbit { border: 1rpx solid rgba(226,195,129,.14); border-radius: 50%; height: 310rpx; position: absolute; right: -74rpx; top: -108rpx; width: 310rpx; }
.advisor-list__summary-top { align-items: center; display: flex; justify-content: space-between; position: relative; }
.advisor-list__number { color: #e2c47f; font-family: "Songti SC", serif; font-size: 62rpx; font-weight: 700; }
.advisor-list__summary-label { font-size: 24rpx; margin-left: 12rpx; }
.advisor-list__summary-mark { align-items: center; border: 1rpx solid rgba(226,196,129,.32); border-radius: 50%; color: #dfbf77; display: flex; height: 66rpx; justify-content: center; width: 66rpx; }
.advisor-list__summary-note { color: rgba(255,255,255,.68); display: block; font-size: 22rpx; margin-top: 10rpx; }
.advisor-list__summary-rule { align-items: center; color: rgba(226,196,129,.7); display: flex; font-size: 16rpx; letter-spacing: 2rpx; margin-top: 28rpx; }
.advisor-list__summary-rule view { background: rgba(226,196,129,.35); height: 1rpx; margin-right: 14rpx; width: 72rpx; }

.advisor-list__body { padding-bottom: calc(70rpx + env(safe-area-inset-bottom)); padding-top: 32rpx; }
.advisor-search-wrap { align-items: center; background: rgba(255,253,249,.96); border: 1rpx solid rgba(183,132,39,.17); border-radius: 999rpx; box-shadow: 0 12rpx 34rpx rgba(26,38,50,.06); display: flex; min-height: 88rpx; padding: 0 24rpx; }
.advisor-search-wrap__icon { color: #a57429; font-family: serif; font-size: 34rpx; margin-right: 14rpx; }
.advisor-search { color: #1a2c3e; flex: 1; font-size: 25rpx; height: 88rpx; min-width: 0; padding: 0; }
.advisor-search-wrap__active { background: #f5ead7; border-radius: 999rpx; color: #8f6828; font-size: 18rpx; margin-left: 12rpx; padding: 8rpx 13rpx; }
.advisor-list__section-head { align-items: flex-end; display: flex; justify-content: space-between; margin-top: 42rpx; }
.advisor-list__section-title { color: #11253a; display: block; font-family: "Songti SC", serif; font-size: 36rpx; font-weight: 700; margin-top: 7rpx; }
.advisor-list__result-count { color: #897f73; font-size: 21rpx; padding-bottom: 5rpx; }

.family-list { margin-top: 18rpx; }
.family-row { align-items: center; background: rgba(255,253,249,.94); border: 1rpx solid rgba(183,132,39,.14); border-radius: 25rpx; box-shadow: 0 12rpx 34rpx rgba(28,38,49,.05); display: flex; margin-top: 15rpx; min-height: 148rpx; padding: 24rpx 20rpx; }
.family-row__crest { align-items: center; background: linear-gradient(145deg, #f3e3c3, #d6ae62); border: 5rpx solid #fffaf1; border-radius: 50%; color: #1b3044; display: flex; flex-shrink: 0; font-family: "Songti SC", serif; font-size: 27rpx; height: 72rpx; justify-content: center; margin-right: 19rpx; width: 72rpx; }
.family-row__content { flex: 1; min-width: 0; }
.family-row__top, .family-row__bottom { align-items: center; display: flex; justify-content: space-between; }
.family-row__name { color: #10253a; font-family: "Songti SC", serif; font-size: 30rpx; font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.family-row__top .status { flex-shrink: 0; margin-left: 14rpx; }
.family-row__meta { color: #6f7479; display: block; font-size: 21rpx; line-height: 1.55; margin-top: 9rpx; overflow-wrap: anywhere; }
.family-row__bottom { color: #8f6a2b; font-size: 19rpx; margin-top: 14rpx; }
.family-row__bottom text:last-child { color: #8f887f; margin-left: 12rpx; }
.family-row__chevron { color: #b37d28; font-size: 34rpx; margin-left: 14rpx; }

.advisor-empty { align-items: center; background: rgba(255,253,249,.92); border: 1rpx solid rgba(183,132,39,.15); border-radius: 28rpx; display: flex; flex-direction: column; margin-top: 20rpx; padding: 68rpx 34rpx; text-align: center; }
.advisor-empty__mark { align-items: center; border: 1rpx solid rgba(177,124,35,.3); border-radius: 50%; color: #a46f1d; display: flex; font-size: 34rpx; height: 76rpx; justify-content: center; margin-bottom: 24rpx; width: 76rpx; }
.advisor-empty__copy { display: block; margin-top: 13rpx; }
.advisor-list__boundary { align-items: center; color: #817a71; display: flex; font-size: 20rpx; justify-content: center; margin-top: 36rpx; }
.advisor-list__boundary-mark { color: #a8782f; margin-right: 10rpx; }

@media (max-width: 340px) {
  .advisor-list__brand brand-mark { display: none; }
  .family-row__bottom { align-items: flex-start; flex-direction: column; }
  .family-row__bottom text:last-child { margin: 6rpx 0 0; }
}
