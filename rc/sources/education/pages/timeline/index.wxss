.timeline-page {
  background:
    radial-gradient(circle at 94% 4%, rgba(226, 190, 114, .22), transparent 29%),
    linear-gradient(180deg, #fffdf9 0%, #faf5ec 56%, #f8f1e6 100%);
  min-height: 100vh;
  overflow: hidden;
  position: relative;
}

.timeline-feather {
  opacity: .2;
  pointer-events: none;
  position: absolute;
  right: -132rpx;
  top: 38rpx;
  transform: rotate(18deg);
  width: 440rpx;
}

.timeline-orbit {
  border: 1rpx solid rgba(189, 139, 48, .13);
  border-radius: 50%;
  pointer-events: none;
  position: absolute;
  right: -190rpx;
  top: 160rpx;
}

.timeline-orbit--outer { height: 480rpx; width: 480rpx; }
.timeline-orbit--inner { height: 320rpx; margin-right: 80rpx; margin-top: 80rpx; width: 320rpx; }

.timeline-shell { padding-bottom: calc(72rpx + env(safe-area-inset-bottom)); position: relative; z-index: 1; }
.timeline-brand { align-items: center; display: flex; min-height: 76rpx; }

.timeline-hero { padding: 58rpx 6rpx 24rpx; text-align: center; }
.timeline-hero__compass {
  align-items: center;
  background: rgba(255, 253, 249, .9);
  border: 1rpx solid rgba(183, 132, 39, .35);
  border-radius: 50%;
  box-shadow: 0 10rpx 30rpx rgba(137, 95, 25, .1);
  color: #b57d22;
  display: flex;
  font-size: 31rpx;
  height: 78rpx;
  justify-content: center;
  margin: 0 auto 25rpx;
  width: 78rpx;
}

.timeline-title { display: block; font-size: 52rpx; letter-spacing: 2rpx; margin-top: 22rpx; white-space: pre-line; }
.timeline-copy { display: block; margin: 20rpx auto 0; max-width: 610rpx; }
.timeline-hero__rule { align-items: center; color: #c49336; display: flex; font-size: 12rpx; justify-content: center; margin-top: 30rpx; }
.timeline-hero__rule view { background: rgba(183, 132, 39, .35); height: 1rpx; width: 76rpx; }
.timeline-hero__rule text { margin: 0 16rpx; }

.timeline-state {
  align-items: center;
  background: rgba(255, 253, 249, .92);
  border: 1rpx solid rgba(183, 132, 39, .16);
  border-radius: 32rpx;
  box-shadow: 0 22rpx 60rpx rgba(28, 38, 50, .07);
  display: flex;
  flex-direction: column;
  margin-top: 30rpx;
  overflow: hidden;
  padding: 64rpx 36rpx;
  position: relative;
  text-align: center;
}

.timeline-state::before {
  background: linear-gradient(90deg, transparent, rgba(197, 150, 61, .55), transparent);
  content: "";
  height: 1rpx;
  left: 12%;
  position: absolute;
  right: 12%;
  top: 0;
}

.timeline-state__mark {
  align-items: center;
  border: 1rpx solid rgba(183, 132, 39, .34);
  border-radius: 50%;
  color: #ad7620;
  display: flex;
  font-family: serif;
  font-size: 35rpx;
  height: 76rpx;
  justify-content: center;
  margin-bottom: 24rpx;
  width: 76rpx;
}

.timeline-state__mark--error { border-color: rgba(148, 66, 54, .25); color: #91473d; }
.timeline-state__mark--loading { font-size: 25rpx; }
.timeline-state__title, .timeline-state__copy, .timeline-state__hint { display: block; }
.timeline-state__copy { margin-top: 14rpx; }
.timeline-state__hint { color: #9a793e; font-size: 21rpx; margin-top: 20rpx; }
.timeline-state__button {
  background: linear-gradient(135deg, #d8ad58, #b98120);
  box-shadow: 0 14rpx 28rpx rgba(151, 103, 23, .18);
  color: #13263a;
  margin-top: 34rpx;
  min-width: 330rpx;
}
.timeline-state__button text { font-size: 34rpx; margin-left: 24rpx; }

.timeline-skeleton { margin-top: 32rpx; width: 100%; }
.timeline-skeleton view { background: linear-gradient(90deg, #f3ecdf, #fbf8f1, #f3ecdf); border-radius: 999rpx; height: 16rpx; margin: 16rpx auto 0; width: 88%; }
.timeline-skeleton view:nth-child(2) { width: 72%; }
.timeline-skeleton view:nth-child(3) { width: 56%; }

.timeline { margin-top: 34rpx; }
.timeline__intro { align-items: center; display: flex; justify-content: space-between; margin-bottom: 26rpx; padding: 0 4rpx; }
.timeline__intro-label { color: #15283b; font-family: "Songti SC", serif; font-size: 32rpx; font-weight: 700; }
.timeline__intro-count { color: #91713b; font-size: 21rpx; }
.timeline__item { display: flex; min-height: 168rpx; }
.timeline__rail { align-items: center; display: flex; flex-direction: column; margin-right: 22rpx; width: 62rpx; }
.timeline__icon {
  align-items: center;
  background: #fffdf9;
  border: 2rpx solid #c49137;
  border-radius: 50%;
  box-shadow: 0 7rpx 18rpx rgba(166, 113, 24, .12);
  color: #a66f1b;
  display: flex;
  font-family: "Songti SC", serif;
  font-size: 21rpx;
  height: 58rpx;
  justify-content: center;
  width: 58rpx;
}
.timeline__line { background: linear-gradient(#d6b776, #eee2ca); flex: 1; width: 1rpx; }
.timeline__item:last-child .timeline__line { background: linear-gradient(#d6b776, transparent); }
.timeline__content {
  background: rgba(255, 253, 249, .9);
  border: 1rpx solid rgba(183, 132, 39, .15);
  border-radius: 24rpx;
  box-shadow: 0 12rpx 34rpx rgba(22, 35, 49, .045);
  flex: 1;
  margin-bottom: 25rpx;
  min-width: 0;
  padding: 24rpx 48rpx 26rpx 26rpx;
  position: relative;
}
.timeline__meta { align-items: center; display: flex; flex-wrap: wrap; justify-content: space-between; }
.timeline__label { color: #9a6d25; font-size: 21rpx; font-weight: 600; letter-spacing: 1rpx; }
.timeline__date { color: #8a8177; font-size: 20rpx; margin-left: 16rpx; }
.timeline__description { color: #14263a; display: block; font-size: 27rpx; font-weight: 600; line-height: 1.6; margin-top: 12rpx; overflow-wrap: anywhere; }
.timeline__content-mark { color: rgba(188, 135, 43, .4); font-size: 15rpx; position: absolute; right: 20rpx; top: 50%; transform: translateY(-50%); }

.timeline-privacy { align-items: center; color: #8b8378; display: flex; font-size: 21rpx; justify-content: center; margin-top: 34rpx; }
.timeline-privacy__icon { color: #a77b35; margin-right: 10rpx; }

@media (max-width: 340px) {
  .timeline-title { font-size: 46rpx; }
  .timeline__meta { align-items: flex-start; flex-direction: column; }
  .timeline__date { margin: 8rpx 0 0; }
}
