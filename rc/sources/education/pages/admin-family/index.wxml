<view class="admin-detail-page">
  <image class="admin-detail__feather" src="/assets/ui/feather-champagne.png" mode="widthFix" aria-hidden="true" />

  <view wx:if="{{overview}}" class="admin-detail">
    <view class="page admin-detail__brand"><brand-mark /><text>ADVISOR VIEW</text></view>

    <view class="admin-detail__hero">
      <view class="admin-detail__hero-orbit" aria-hidden="true"></view>
      <text class="eyebrow admin-detail__eyebrow">FAMILY OVERVIEW</text>
      <text class="admin-detail__name">{{overview.family.family_name}}</text>
      <text class="admin-detail__meta">{{overview.family.parent_name}} · {{overview.family.phone}} · {{overview.family.location || '地区待完善'}}</text>
      <view class="admin-detail__goal"><text class="admin-detail__goal-mark" aria-hidden="true">✦</text><text>“{{overview.family.goal || '家庭目标待完善'}}”</text></view>
      <view class="admin-detail__hero-rule" aria-hidden="true"><view></view><text>CONFIDENTIAL FAMILY CONTEXT</text></view>
    </view>

    <view class="page admin-detail__body">
      <view class="admin-section">
        <view class="section-head">
          <view><text class="admin-section__eyebrow">STUDENT PROFILES</text><text class="h3 admin-section__title">孩子档案</text></view>
          <text class="admin-section__count">{{overview.students.length}} 位</text>
        </view>
        <view wx:if="{{overview.students.length}}">
          <view wx:for="{{overview.students}}" wx:key="id" class="student-row">
            <view class="student-row__avatar">{{item.initial}}</view>
            <view class="student-row__copy"><text class="student-row__name">{{item.name}}</text><text class="student-row__meta">{{item.school}} · {{item.grade}} · {{item.education_system || '课程体系待完善'}}</text></view>
          </view>
        </view>
        <view wx:else class="admin-section__empty"><text aria-hidden="true">◇</text><text>尚未建立孩子档案</text></view>
      </view>

      <view class="admin-section">
        <view class="section-head">
          <view><text class="admin-section__eyebrow">GROWTH REPORTS</text><text class="h3 admin-section__title">成长报告</text></view>
          <text class="admin-section__count">{{overview.reports.length}} 份</text>
        </view>
        <view wx:if="{{overview.reports.length}}" class="report-list">
          <view wx:for="{{overview.reports}}" wx:key="id" class="report-row" data-id="{{item.id}}" role="button" bindtap="openReport">
            <view class="report-row__mark" aria-hidden="true">析</view>
            <view class="report-row__copy"><text class="report-row__date">{{item.dateLabel}}</text><text class="report-row__title">{{item.summary.currentStage}}</text></view>
            <text class="chevron">›</text>
          </view>
        </view>
        <view wx:else class="admin-section__empty"><text aria-hidden="true">◇</text><text>尚未完成 Education Compass</text></view>
      </view>

      <view class="admin-section">
        <view class="section-head">
          <view><text class="admin-section__eyebrow">CONTACT REQUESTS</text><text class="h3 admin-section__title">联系申请</text></view>
          <text wx:if="{{overview.requests.length}}" class="status status--warm">{{overview.requests.length}} 项待查看</text>
          <text wx:else class="admin-section__count">0 项</text>
        </view>
        <view wx:if="{{overview.requests.length}}">
          <view wx:for="{{overview.requests}}" wx:key="id" class="request-card">
            <view class="request-card__top"><text class="request-card__topic">{{item.topic}}</text><text class="request-card__mark" aria-hidden="true">✦</text></view>
            <text class="request-card__meta">{{item.preferred_time}} · {{item.dateTimeLabel}}</text>
            <text wx:if="{{item.note}}" class="request-card__note">{{item.note}}</text>
          </view>
        </view>
        <view wx:else class="admin-section__empty"><text aria-hidden="true">◇</text><text>当前没有家庭联系申请</text></view>
      </view>

      <view class="admin-section note-form">
        <view class="note-form__heading"><view><text class="admin-section__eyebrow">ADVISOR NOTE</text><text class="h3 admin-section__title">添加顾问备注</text></view><text aria-hidden="true">✦</text></view>
        <text class="note-form__hint">仅记录本次判断与下一步；不要填写未经授权的问卷原文。</text>
        <textarea class="textarea note-form__textarea" value="{{note}}" maxlength="500" placeholder="记录本次判断、沟通重点或下一步……" aria-label="顾问备注" bindinput="inputNote"></textarea>
        <picker mode="selector" range="{{statuses}}" value="{{statusIndex}}" bindchange="pickStatus"><view class="picker note-form__picker"><text>跟进状态</text><text>{{statuses[statusIndex]}}　›</text></view></picker>
        <button class="btn note-form__button" bindtap="addNote">保存跟进记录 <text aria-hidden="true">→</text></button>
      </view>

      <view class="admin-section">
        <view class="section-head"><view><text class="admin-section__eyebrow">INTERNAL NOTES</text><text class="h3 admin-section__title">内部跟进记录</text></view><text class="admin-section__count">{{overview.notes.length}} 条</text></view>
        <view wx:if="{{overview.notes.length}}">
          <view wx:for="{{overview.notes}}" wx:key="id" class="note-row">
            <view class="row row--between"><text class="status">{{item.follow_up_status}}</text><text class="note-row__date">{{item.dateTimeLabel}}</text></view>
            <text class="note-row__copy">{{item.note}}</text>
          </view>
        </view>
        <view wx:else class="admin-section__empty"><text aria-hidden="true">◇</text><text>尚无内部跟进记录</text></view>
      </view>

      <view class="admin-section">
        <view class="section-head"><view><text class="admin-section__eyebrow">FAMILY TIMELINE</text><text class="h3 admin-section__title">家庭时间线</text></view><text class="admin-section__count">{{overview.events.length}} 条</text></view>
        <view wx:if="{{overview.events.length}}" class="event-list">
          <view wx:for="{{overview.events}}" wx:key="id" class="event-row"><view class="event-row__dot" aria-hidden="true"></view><view><text class="event-row__date">{{item.dateTimeLabel}}</text><text class="event-row__copy">{{item.description}}</text></view></view>
        </view>
        <view wx:else class="admin-section__empty"><text aria-hidden="true">◇</text><text>尚无家庭时间线记录</text></view>
      </view>

      <view class="admin-detail__boundary"><text aria-hidden="true">◇</text><text>内部演示详情 · 不进入家庭端发布包</text></view>
    </view>
  </view>

  <view wx:else class="page admin-detail__loading" aria-busy="true">
    <brand-mark />
    <view class="admin-detail__loading-mark" aria-hidden="true">✦</view>
    <text class="h3">正在读取家庭详情</text>
    <text class="muted">请稍候，家庭档案正在整理</text>
    <view class="admin-detail__loading-card" aria-hidden="true"><view></view><view></view><view></view></view>
  </view>
</view>
